<?xml version="1.0" encoding="UTF-8"?>
<!-- Structured JSON logs with the Lambda context (Powertools for AWS Lambda). -->
<Configuration>
    <Appenders>
        <Console name="JsonAppender" target="SYSTEM_OUT">
            <JsonTemplateLayout eventTemplateUri="classpath:LambdaJsonLayout.json"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.example.claudemicrovm" level="INFO" additivity="false">
            <AppenderRef ref="JsonAppender"/>
        </Logger>
        <Root level="WARN">
            <AppenderRef ref="JsonAppender"/>
        </Root>
    </Loggers>
</Configuration>
